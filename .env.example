# Required for live model calls (server-side only). Without it the app runs in mock mode.
ANTHROPIC_API_KEY=

# Optional overrides. Leave unset for defaults (blank values are treated as unset).
# MAIN_MODEL=claude-opus-5          # main agent
# MAIN_FALLBACKS=off                # disable server-side refusal fallbacks (on by default)
# MOCK_MAIN=1                       # force the scripted main agent even with a key
# LEARN_MODEL=claude-sonnet-5       # learning sub-agent
# GRADER_MODEL=claude-sonnet-5      # answer grader
# CLASSIFIER_MODEL=claude-haiku-4-5 # learnability check
# MOCK_LEARN=1                      # force the scripted learning agent even with a key
